	"C Boilerplate": {
		"prefix": "cmain",
		"body": [
			"#include <stdio.h>",
			"#include <stdlib.h>",
			"",
			"int main() {",
			"",
			"    printf(\"$0\\n\");",
			"",
			"    return 0;",
			"}"
		],
		"description": "Basic C boilerplate template"
	},

	"C Boilerplate Input": {
		"prefix": "cinput",
		"body": [
			"#include <stdio.h>",
			"#include <stdlib.h>",
			"",
			"int main() {",
			"    int n;",
			"    printf(\"Enter $0: \");",
			"    scanf(\"%d\", &n);",
			"",
			"    printf(\"You entered: %d\\n\", n);",
			"",
			"    return 0;",
			"}"
		],
		"description": "C boilerplate with input"
	}
}