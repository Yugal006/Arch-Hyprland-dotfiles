{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "/home/yloryth/.config/fastfetch/media/girl1.png",

    "height": 25,

    "padding": {
      "top": 3,
      "right": 2
    }
  },

  "display": {
    "separator": " ▸ "
  },

  "modules": [

    {
      "type": "title",
      "color": {
        "user": "#5ef1ff",
        "at": "#7a88ff",
        "host": "#ff5ea0"
      }
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[38;2;94;241;255m┌────────────────────── Cyber System ──────────────────────┐"
    },

    {
      "type": "os",
      "key": "  OS:",
      "keyColor": "#5ef1ff"
    },

    {
      "type": "kernel",
      "key": "│ Kernel:  ",
      "keyColor": "#5ef1ff"
    },

    {
      "type": "shell",
      "key": "│ Shell:  ",
      "keyColor": "#5ef1ff"
    },

    {
      "type": "terminal",
      "key": "│ Terminal:  ",
      "keyColor": "#5ef1ff"
    },

    {
      "type": "terminalfont",
      "key": "│ Font: 󰛖 ",
      "keyColor": "#5ef1ff"
    },

    {
      "type": "wm",
      "key": "│ WM:  ",
      "keyColor": "#5ef1ff"
    },

    {
      "type": "wmtheme",
      "key": "│ Theme:  ",
      "keyColor": "#5ef1ff"
    },

    {
      "type": "packages",
      "key": "└ Packages: 󰏖 ",
      "keyColor": "#5ef1ff"
    },



    {
      "type": "custom",
      "format": "\u001b[38;2;94;161;255m├────────────────────── Cyber Hardware ───────────────────┤"
    },

    {
      "type": "host",
      "key": "󰌢 Host:",
      "keyColor": "#5ea1ff"
    },

    {
      "type": "bios",
      "key": "│ BIOS:  ",
      "keyColor": "#5ea1ff"
    },

    {
      "type": "cpu",
      "key": "│ CPU: 󰍛 ",
      "keyColor": "#5ea1ff"
    },

    {
      "type": "gpu",
      "key": "│ GPU: 󰢮 ",
      "keyColor": "#5ea1ff"
    },

    {
      "type": "memory",
      "key": "│ RAM:  ",
      "keyColor": "#5ea1ff"
    },

    {
      "type": "swap",
      "key": "│ Swap: 󰓡 ",
      "keyColor": "#5ea1ff"
    },

    {
      "type": "disk",
      "key": "│ Disk:  ",
      "keyColor": "#5ea1ff"
    },

    {
      "type": "battery",
      "key": "└ Battery: 󰁹 ",
      "keyColor": "#5ea1ff"
    },



    {
      "type": "custom",
      "format": "\u001b[38;2;255;94;160m├────────────────────── Cyber Session ────────────────────┤"
    },

    {
      "type": "uptime",
      "key": " Uptime:",
      "keyColor": "#ff5ea0"
    },

    {
      "type": "datetime",
      "key": "│ Time:  ",
      "keyColor": "#ff5ea0"
    },

    {
      "type": "command",
      "key": "│ System Age:  ",
      "keyColor": "#ff5ea0",
      "text": "birth=$(stat -c %W /); now=$(date +%s); echo $(((now-birth)/86400)) days"
    },

    {
      "type": "media",
      "key": "│ Playing: 󰝚 ",
      "keyColor": "#ff5ea0"
    },

    {
      "type": "localip",
      "key": "│ IP: 󰩠 ",
      "keyColor": "#ff5ea0"
    },

    {
      "type": "weather",
      "key": "└ Weather:  ",
      "keyColor": "#ff5ea0"
    },



    {
      "type": "custom",
      "format": "\u001b[38;2;241;255;94m└─────────────────────────────────────────────────────────┘"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 18,
      "symbol": "circle",
      "block": {
        "width": 5
      }
    },

    "break",

    {
      "type": "custom",
      "format": "      \u001b[38;2;94;241;255m  \u001b[38;2;94;161;255m  \u001b[38;2;255;94;160m󰣇  \u001b[38;2;241;255;94m󰍹  \u001b[38;2;255;182;94m󰖟"
    },

    "break"
  ]
}
