/**
 *
 * Fixed Layout + Bigger Icons
 * (Same colors, same style, improved spacing)
 *
 **/

configuration {
    show-icons: false;
}

@import "~/.config/rofi/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Mono 18";

    background: @surface;
    background-alt: @surface-container;
    foreground: @on-surface;

    selected: @primary;
    active: @tertiary;
    urgent: @error;
}

/*****----- Main Window -----*****/
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;

    width: 800px;

    border: 2px;
    border-radius: 25px;
    border-color: @primary;

    background-color: @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled: true;
    spacing: 15px;
    padding: 20px;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled: true;
    spacing: 20px;
    padding: 8px 20px;

    border-radius: 25px;

    background-color: transparent;
    background-image: none;

    text-color: @foreground;

    children: [ "textbox-prompt-colon", "dummy", "prompt"];
}
imagebox {
    padding: 20px;
    background-color: transparent;
    background-image: none;
    orientation: vertical;
    children: [ "inputbar", "dummy" ];
}

listbox {
    spacing: 20px;
    padding: 20px;
    background-color: transparent;
    orientation: vertical;
    children: [ "message", "listview" ];
}
textbox-prompt-colon {
    enabled: true;
    expand: false;
    str: "  ";
    padding: 12px;
    border-radius: 100%;
    background-color: @urgent;
    text-color: @background;
}

prompt {
    enabled: true;
    padding: 10px 15px;
    border-radius: 100%;
    background-color: @active;
    text-color: @background;
}

dummy {
    background-color: transparent;
}

/*****----- Message -----*****/
message {
    enabled: true;
    padding: 8px;
    border-radius: 20px;
    background-color: @background-alt;
    text-color: @foreground;
}

textbox {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

/*****----- Listview (FIXED) -----*****/
listview {
    enabled: true;

    columns: 4;        /* was 6 → gives more space */
    lines: 1;

    spacing: 15px;
    padding: 5px;

    cycle: true;
    scrollbar: false;

    background-color: transparent;
}

/*****----- Elements -----*****/
element {
    padding: 18px;     /* balanced spacing */
    border-radius: 20px;
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @foreground;
}

/*****----- ICON SIZE FIX -----*****/
element-text {
    font: "JetBrainsMono Nerd Font Mono 28";  /* BIGGER ICONS */

    background-color: transparent;
    text-color: inherit;

    vertical-align: 0.5;
    horizontal-align: 0.5;
}

/*****----- STATES -----*****/
element normal.normal,
element alternate.normal {
    background-color: var(background-alt);
    text-color: var(foreground);
}

element normal.urgent,
element alternate.urgent,
element selected.active {
    background-color: var(urgent);
    text-color: var(background);
}

element normal.active,
element alternate.active,
element selected.urgent {
    background-color: var(active);
    text-color: var(background);
}

element selected.normal {
    background-color: var(selected);
    text-color: var(background);
}
